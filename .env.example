# LLM provider config - any OpenAI-compatible endpoint works.
# Leave OPENAI_API_KEY empty (or starting with "demo"/"sk-demo") to run
# in fully simulated demo mode.
# The app reads these via python-dotenv (loaded at startup from .env).
#
# Rate-limit safety: free Groq tier is ~30 req/min and ~7200 tok/min.
# The client throttles to one real-API call every 2.5s (overridable
# via LLM_MIN_INTERVAL in seconds) and retries 3x on 429 with exponential
# backoff. If the live API is unavailable, the dashboard shows a yellow
# banner and surfaces the failure on the affected alerts (no silent
# fallback to the simulator).

# Groq (default - the free tier supports openai/gpt-oss-20b)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Tencent Cloud / 混元 / DeepSeek / any other OpenAI-compatible host:
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://your-host/v1
# OPENAI_MODEL=your-model

# Server port (optional)
PORT=5000

# Minimum seconds between consecutive real-API calls. Default 2.5s keeps
# a 15-call run safely under Groq free tier's 30 req/min budget.
# LLM_MIN_INTERVAL=2.5

# Opt-in: force response_format={"type":"json_object"} on every request.
# Leave UNSET (recommended) for openai/gpt-oss-20b on Groq - that model
# rejects the parameter with HTTP 400 as of 2026-07. The improved JSON
# parser in agents.py handles reasoning-preamble + non-JSON output on its
# own, so this flag is only useful if you switch to a model that supports
# structured output mode (e.g. llama-3.1-70b-versatile on Groq).
# LLM_JSON_MODE=1